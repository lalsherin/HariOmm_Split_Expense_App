# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Database. docker-compose sets this for you.
DATABASE_URL=postgresql+asyncpg://splitledger:change-me@localhost:5432/splitledger

# Identity
DEFAULT_COUNTRY_CODE=+91

# Sessions
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# ---------------------------------------------------------------------------
# Phone verification.
#
# REQUIRE_OTP=false means ANYONE WHO TYPES A NUMBER BECOMES THAT PERSON.
# That is the deliberate setting for a private group of people who know each
# other. Set it to true, and configure a provider below, before this server is
# reachable by anyone you do not trust.
# ---------------------------------------------------------------------------
REQUIRE_OTP=false
OTP_LENGTH=4
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# SMS provider. "console" writes the code to the log instead of sending it.
# For Indian numbers a real provider also needs a DLT-registered sender ID
# and an approved template — that is a regulatory step, not a code change.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

# Rate limits: requests per window, window in seconds
RL_AUTH_PER_NUMBER=10
RL_AUTH_PER_NUMBER_WINDOW=3600
RL_AUTH_PER_IP=30
RL_AUTH_PER_IP_WINDOW=3600
RL_SYNC_PER_USER=600
RL_SYNC_PER_USER_WINDOW=3600

# The Android app loads from file:// and sends Origin: null, so it needs "*".
# Tighten this if only a website will call the API.
CORS_ORIGINS=*

LOG_LEVEL=INFO
