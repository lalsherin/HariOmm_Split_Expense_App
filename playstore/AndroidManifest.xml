<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sherinlal.splitledger"
    android:versionCode="29"
    android:versionName="3.15">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="36" />

    <!-- Needed to sync groups between phones. Nothing else is requested:
         no contacts, no storage, no location. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Asked for only when you tap Contacts while adding a group member, and
         used only to read the numbers saved against the one contact you chose,
         so the app can ask which of them to use. Nothing is uploaded: the
         number goes into your group, the name never leaves the phone. Decline
         it and the picker still works, with whichever number it returns. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.sherinlal.splitledger.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Group invite links. Verified App Link: tapping
                 https://split-ledger-71my.onrender.com/join/<token> opens the
                 app directly once Android has checked the server's
                 /.well-known/assetlinks.json against this app's certificate. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="split-ledger-71my.onrender.com" android:pathPrefix="/join/" />
            </intent-filter>
            <!-- ...and the "Open in Split Buddy" button on that page, for when
                 the link opened in the browser instead. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="splitbuddy" android:host="join" />
            </intent-filter>
        </activity>

        <!-- Hands the generated share card (cache/share/split-buddy-card.png)
             to the app the user picks, as a content:// URI with a one-off read
             grant. Not exported: nothing else can open it on its own. -->
        <provider
            android:name="com.sherinlal.splitledger.ShareProvider"
            android:authorities="com.sherinlal.splitledger.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
